# Client: blank uses the same origin; Vite forwards /socket.io in development.
VITE_SERVER_URL=
# URL visible to phones, used for QR. Blank defaults to current page origin/path.
VITE_PUBLIC_APP_URL=
# Server (set in the shell/hosting environment, not bundled into the client)
PORT=3001
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Durable private paths, outside the repository, build output and temporary directories.
CLASSROOM_DB_PATH=/workspace/duaxe-data/classroom.sqlite
CLASSROOM_AVATAR_DIR=/workspace/duaxe-data/avatars
# Production HTTPS: NODE_ENV=production enables Secure teacher cookies.
# Do not prefix server credentials or paths with VITE_.

# 9B.1 backend only; SQLite remains the default. Never use VITE_ for DB credentials.
STORAGE_DRIVER=sqlite
# DATABASE_URL= (set privately; do not commit)
PG_POOL_MAX=4
PG_CONNECT_TIMEOUT_MS=2000
PG_STATEMENT_TIMEOUT_MS=3000
PG_LOCK_TIMEOUT_MS=1000
PG_QUERY_TIMEOUT_MS=5000
# Remote PostgreSQL always verifies TLS; disable is allowed only for loopback tests.
PG_SSL_MODE=verify-full
# PG_SSL_CA_FILE= (optional provider CA, verification stays enabled)
# PG_AVATAR_DIR= (private COPY separate from the SQLite source)
# Migration commands require PG_MIGRATION_TARGET=staging and PG_MIGRATION_DATABASE_NAME.

# 9B.1.1 optional checks: inject credentials privately, never use production URLs.
# PG_TEST_URL= (actual local test database; loopback only, CREATE DATABASE/ROLE for fixtures)
# PG_BENCHMARK_PHASE=before|after
# PG_BENCHMARK_REPEATS=3
# BENCHMARK_CLIENTS=1|5|10|15|20
# PG_STAGING_URL= (separate runtime credential for confirmed staging; read-only probe)
# PG_STAGING_CONFIRMED=1
# PG_STAGING_EXPECTED_HOST= (exact staging DB host, checked before connecting)
# PG_STAGING_CONNECTION_MODE=direct|session (transaction pooler is unsupported)

# Cloud production (configure hosting environment; defaults above remain local/legacy).
TEACHER_AUTH_DRIVER=legacy
AVATAR_STORAGE_DRIVER=local
VITE_AUTH_DRIVER=legacy
# SUPABASE_URL=https://<project-ref>.supabase.co (ordinary server variable, not a credential)
# SUPABASE_STORAGE_KEY= (server-only HTTP/API secret; never VITE_)
# SUPABASE_AUTH_ADMIN_KEY= (operator only, not required by Render runtime)
# SUPABASE_AVATAR_BUCKET=student-avatars
# VITE_SUPABASE_URL= (same public project URL, Pages build variable)
# VITE_SUPABASE_PUBLISHABLE_KEY= (publishable/anon only, Pages build variable)
# Production requires STORAGE_DRIVER=postgres and both Auth/Storage drivers=supabase.
PRODUCTION_ACCESS_MODE=closed
# BACKEND_GATEWAY_KEY= (same high-entropy secret in Render and Pages Functions)
# Pages Functions only: ACCESS_MODE=closed, BACKEND_URL=https://<service>.onrender.com
# SUPABASE_PUBLIC_ORIGIN= (same public Supabase URL for CSP)
# Pilot: CF_ACCESS_TEAM_DOMAIN, CF_ACCESS_AUD. Protect Pages preview deployments too.
# Managed HTTP secret proxies: NODE_USE_ENV_PROXY=1 when running Node HTTP checks;
# retain injected proxy/CA configuration. PostgreSQL/WSS need appropriate TCP access.
# NEVER set CLOUD_OPERATION_APPROVED or CLOUD_ACCEPTANCE_APPROVED on the web service.
# Operator only, after explicit approval: CLOUD_TARGET, CLOUD_OPERATION_APPROVED,
# CLOUD_EXPECTED_DB_HOST, CLOUD_EXPECTED_DATABASE. Default command mode is a plan.
# Runtime DB uses a dedicated NOSUPERUSER/NOBYPASSRLS login; admin URL is operator-only.
# Pages Functions BACKEND_GATEWAY_KEY must match Render's encrypted environment secret.
# Browser auth login uses password form + refresh; project must use ES256/RS256 signing.

# 9B.2 cloud runtime requires schema003 (explicit operator migration, never at boot).
# SUPABASE_STORAGE_KEY must also allow Auth Admin GET user for fresh ban/status checks;
# no key values, passwords, JWTs or recovery links belong in this file or the frontend.
# Supabase Site URL: https://<app>.pages.dev/
# Exact Redirect URL: https://<app>.pages.dev/?mode=teacher&auth=recovery&fresh=1
# Current signup policy is below; configure custom SMTP, verified sender and rates.
# Operator account migration ONLY after separate explicit user approval and backup:
# CLOUD_EXPECTED_SUPABASE_URL= (same exact HTTPS project origin)
# CLOUD_AUTH_REDIRECT_URL= (the exact teacher recovery URL above)
# SUPABASE_AUTH_ADMIN_KEY= (separate private operator provisioning key)
# See SUPABASE_AUTH_PRODUCTION_MIGRATION.md for dry-run, intent journal and rollback.

# Current production policy: self-signup, confirmed email, no account approval queue.
# Set BOTH flags true in the approved cloud deployment. Local/legacy defaults stay off.
TEACHER_SELF_SIGNUP=false
VITE_SELF_SIGNUP_ENABLED=false
# VITE_TURNSTILE_SITE_KEY= (public widget site key, Pages build; no CAPTCHA secret)
# Put the same widget SECRET in Supabase Auth CAPTCHA settings AND Render's encrypted
# TURNSTILE_SECRET_KEY. Never VITE_/chat/git. Node verifies a separate fresh
# teacher-profile token before new role creation; Supabase consumes teacher-auth.
# TURNSTILE_SECRET_KEY= (backend encrypted secret, actual widget secret, no test key)
# TURNSTILE_EXPECTED_HOSTNAME= (exact approved frontend hostname, without scheme/path;
# must match an HTTPS origin in CORS_ORIGINS, for example <app>.pages.dev)
# Supabase Dashboard: allow signup + Email provider + Confirm email ON;
# enable Turnstile CAPTCHA and Auth rate limits; configure custom SMTP.
# Add exact confirmation redirect as well as recovery (no production wildcards):
# https://<app>.pages.dev/?mode=teacher&auth=confirm&fresh=1
# Self-signup requires schema004; cloud:operator schema --self-signup defaults to plan.
# Do not enable admission until legacy teachers are imported/reserved and verified.
