{
  "name": "duong-dua-tri-thuc",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build && npm run server:build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "server": "tsx server/index.ts",
    "server:build": "esbuild server/index.ts server/classroom/cli.ts --bundle --platform=node --format=esm --packages=external --outdir=dist-server --outbase=server",
    "server:start": "node dist-server/index.js",
    "test:browser": "node scripts/browser-smoke.cjs",
    "classroom": "tsx server/classroom/cli.ts",
    "test:classroom-browser": "tsx scripts/classroom-browser.ts",
    "test:persistence": "tsx scripts/persistence-smoke.ts",
    "benchmark:render": "tsx scripts/render-benchmark.ts",
    "benchmark:network": "tsx scripts/network-benchmark.ts",
    "test:sessions-browser": "SESSION_RESTART=1 tsx scripts/classroom-browser.ts",
    "test:crash": "CRASH=1 tsx scripts/persistence-smoke.ts",
    "benchmark:readiness-network": "tsx scripts/readiness-network.ts",
    "test:readiness-browser": "READINESS=1 SESSION_RESTART=1 tsx scripts/classroom-browser.ts",
    "postgres:migrate": "tsx scripts/postgres/migrate.ts",
    "test:postgres": "tsx --test tests/postgres*.test.ts",
    "test:postgres-signals": "tsx scripts/postgres/persistence.ts",
    "test:postgres-browser": "tsx scripts/postgres/browser.ts",
    "test:postgres-migration": "tsx scripts/postgres/migration-smoke.ts",
    "benchmark:postgres-performance": "tsx scripts/postgres/performance.ts",
    "profile:postgres-sql": "tsx scripts/postgres/query-plan.ts",
    "check:postgres-staging": "tsx scripts/postgres/staging-check.ts",
    "cloud:operator": "tsx scripts/cloud/operator.ts",
    "build:pages": "tsx scripts/cloud/check-build.ts && npm run build",
    "test:cloud": "tsx --test tests/cloud*.test.ts",
    "test:cloud-browser": "tsx scripts/cloud/browser.ts",
    "cloud:build-functions": "esbuild functions/_middleware.ts functions/api/[[path]].ts functions/socket.io/[[path]].ts --bundle --platform=browser --format=esm --outdir=/tmp/duaxe-cloudflare-functions --outbase=functions",
    "cloud:acceptance": "tsx scripts/cloud/acceptance.ts",
    "cloud:check-pages": "wrangler pages functions build functions --outdir /tmp/duaxe-pages-check",
    "cloud:preflight": "tsx scripts/cloud/preflight.ts",
    "test:pages-gate": "tsx scripts/cloud/pages-smoke.ts",
    "test:cloud-signals": "tsx scripts/cloud/persistence.ts",
    "test:cloud-operator": "tsx scripts/cloud/operator-smoke.ts",
    "cloud:auth-migration": "tsx scripts/cloud/auth-migration.ts",
    "test:auth-browser": "tsx scripts/cloud/auth-browser.ts",
    "test:auth-operator": "tsx scripts/cloud/auth-operator-smoke.ts",
    "test:signup-browser": "tsx scripts/cloud/signup-browser.ts",
    "cloud:migration-review": "tsx scripts/cloud/migration-review.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "csv-parse": "^7.0.3",
    "exceljs": "^4.4.0",
    "fflate": "^0.8.3",
    "jose": "^6.2.15",
    "pg": "^8.23.1",
    "phaser": "^3.90.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "esbuild": "^0.28.2",
    "miniflare": "^5.20261104.0-beta",
    "playwright": "^1.64.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.1.0",
    "wrangler": "^4.158.0"
  },
  "engines": {
    "node": ">=24"
  }
}
